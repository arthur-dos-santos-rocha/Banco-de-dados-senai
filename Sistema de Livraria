CREATE DATABASE DB_LIVRARIA;

USE DB_LIVRARIA;


-- QUESTÃO 1
CREATE TABLE AUTOR (
  id_autor INTEGER PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(100) NOT NULL,
  nacionalidade VARCHAR(50),
  data_nascimento DATE
);


-- QUESTÃO 2
CREATE TABLE EDITORA (
  id_editora INTEGER PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(100) NOT NULL,
  endereco VARCHAR(200) NOT NULL,
  telefone VARCHAR(20)
);


-- QUESTÃO 3
CREATE TABLE LIVRO (
  id_livro INTEGER PRIMARY KEY AUTO_INCREMENT,
  titulo VARCHAR(200) NOT NULL,
  ano_publicacao YEAR,
  id_editora INTEGER,
  id_autor_principal INTEGER,

  FOREIGN KEY (id_editora) REFERENCES EDITORA(id_editora),
  FOREIGN KEY (id_autor_principal) REFERENCES AUTOR(id_autor)
);


